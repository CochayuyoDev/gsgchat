    },
    {
      "name": "4. Cancelar o reintentar (API 2)",
      "description": "GSG pide dejar de escribirle a un tracking (CANCELAR) o volver a escribirle (REINTENTAR) en POST /api/v1/flujo. Actúa sobre un pedido que ya existe: primero se crea con la API 1. Misma clave que la API 1.",
      "item": [
        {
          "name": "Simular cancelar (no cambia nada)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tracking\": \"{{tracking}}\",\n  \"accion\": \"CANCELAR\",\n  \"simular\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/flujo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "flujo"
              ]
            },
            "description": "Con «simular: true» dice lo que haría sin tocar el pedido."
          },
          "response": [
            {
              "name": "Simulado",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json; charset=utf-8"
                }
              ],
              "body": "{\n  \"ok\": true,\n  \"simulado\": true,\n  \"accion\": \"CANCELAR\",\n  \"tracking\": \"GSG-E-205\",\n  \"detalle\": \"Dejaría de escribirle por este tracking.\"\n}"
