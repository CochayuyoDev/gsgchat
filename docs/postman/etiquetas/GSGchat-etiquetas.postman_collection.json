        {
          "name": "Configurar GSG con una API Key equivocada",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/tienda/{{slug}}/admin/entregas/gsg",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"modo\": \"real\",\n  \"url\": \"{{mock}}/gsg/api/\",\n  \"rutaUbicacion\": \"v1/gsgchat/location\",\n  \"rutaEtiquetas\": \"v1/gsgchat/labels\",\n  \"apiKey\": \"clave-equivocada-0000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con la ruta de etiquetas a la vista', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const g = pm.response.json().gsg;",
                  "  pm.expect(g.rutaEtiquetas).to.equal('v1/gsgchat/labels');",
                  "  pm.expect(g.destinoEtiquetas).to.equal(pm.environment.get('mock') + '/gsg/api/v1/gsgchat/labels');",
                  "});",
                  "pm.test('la respuesta nunca trae la clave', () => pm.expect(pm.response.text()).to.not.include('clave-equivocada-0000'));"
                ]
              }
            }
          ]
