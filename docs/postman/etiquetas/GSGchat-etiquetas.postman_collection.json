              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202: un lote de reintento con las 3 fallidas', () => {",
                  "  pm.response.to.have.status(202);",
                  "  const e = pm.response.json();",
                  "  pm.expect(e.tipo).to.equal('reintento');",
                  "  pm.expect(e.enCurso).to.equal(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Esperar el reintento 1",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/tienda/{{slug}}/admin/chat/etiquetar",
            "description": ""
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 750);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const e = pm.response.json();",
                  "const vueltas = Number(pm.collectionVariables.get('vueltas') || 0);",
                  "if (e.enCurso && vueltas < 60) {",
                  "  pm.collectionVariables.set('vueltas', vueltas + 1);",
