      ]
    },
    {
      "name": "1 · Lote completo con la clave rechazada por GSG",
      "description": "GSG responde 401 al primer envío: el lote no insiste con las demás, las deja fallidas con el motivo y sin gastar intento.",
      "item": [
        {
          "name": "Etiquetar los chats de hoy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/tienda/{{slug}}/admin/chat/etiquetar",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202: el lote completo arranca en segundo plano', () => {",
                  "  pm.response.to.have.status(202);",
                  "  const e = pm.response.json();",
                  "  pm.expect(e.enCurso).to.equal(true);",
                  "  pm.expect(e.tipo).to.equal('completo');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Esperar el lote 1",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/tienda/{{slug}}/admin/chat/etiquetar",
            "description": ""
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 750);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const e = pm.response.json();",
                  "const vueltas = Number(pm.collectionVariables.get('vueltas') || 0);",
                  "if (e.enCurso && vueltas < 60) {",
                  "  pm.collectionVariables.set('vueltas', vueltas + 1);",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.collectionVariables.set('vueltas', 0);",
                  "  pm.test('el lote termino (no se quedo en curso)', () => pm.expect(e.enCurso).to.equal(false));",
                  "  pm.collectionVariables.set('lote1', e.loteId);",
                  "",
                  "  pm.test('3 conversaciones (Luis, guardado dos veces, cuenta una), las 3 por la IA', () => {",
                  "    pm.expect(e.total).to.equal(3);",
                  "    pm.expect(e.clasificadas).to.equal(3);",
                  "    pm.expect(e.porIA).to.equal(3);",
                  "  });",
                  "  pm.test('nada llegó a GSG: 3 fallidas y el lote termina con errores', () => {",
                  "    pm.expect(e.estado).to.equal('completado_con_errores');",
                  "    pm.expect(e.syncTotal).to.equal(3);",
                  "    pm.expect(e.syncEnviadas).to.equal(0);",
                  "    pm.expect(e.syncFallidas).to.equal(3);",
                  "    pm.expect(e.syncMotivo).to.match(/No se intentó/);",
                  "  });",
                  "",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Mock: GSG rechazó UNA (no insistió con la clave mala)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mock}}/control/estado",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const m = pm.response.json();",
                  "pm.test('una sola llamada rechazada con 401 y ninguna aceptada', () => {",
                  "  pm.expect(m.rechazadas.length).to.equal(1);",
                  "  pm.expect(m.rechazadas[0].status).to.equal(401);",
                  "  pm.expect(m.recibidas.length).to.equal(0);",
                  "});",
                  "pm.test('la IA se llamó 3 veces', () => pm.expect(m.llamadasIA).to.equal(3));",
                  "pm.collectionVariables.set('iaTrasLote1', m.llamadasIA);"
                ]
              }
            }
          ]
        },
        {
          "name": "Registro: errores del lote 1",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/tienda/{{slug}}/admin/chat/etiquetar/eventos?loteId={{lote1}}&nivel=error",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const items = pm.response.json().items;",
                  "pm.test('apunta el rechazo de la clave (gsg_clave)', () => pm.expect(items.map((e) => e.codigo)).to.include('gsg_clave'));",
                  "pm.test('todo es de nivel error y de este lote', () => items.forEach((e) => { pm.expect(e.nivel).to.equal('error'); pm.expect(e.loteId).to.equal(pm.collectionVariables.get('lote1')); }));",
                  "pm.test('ni la clave equivocada ni la buena aparecen en el registro', () => {",
                  "  pm.expect(pm.response.text()).to.not.include('clave-equivocada-0000');",
                  "  pm.expect(pm.response.text()).to.not.include(pm.environment.get('claveGsg'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 · Reintentar solo lo fallido, sin volver a la IA",
      "description": "Con la clave buena, Ana falla con 503 y luego se recupera. Cada reintento manda solo lo que falta, con la etiqueta guardada: la IA no vuelve a sonar.",
      "item": [
        {
          "name": "Configurar GSG con la API Key buena",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/tienda/{{slug}}/admin/entregas/gsg",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"modo\": \"real\",\n  \"url\": \"{{mock}}/gsg/api/\",\n  \"rutaUbicacion\": \"v1/gsgchat/location\",\n  \"rutaEtiquetas\": \"v1/gsgchat/labels\",\n  \"apiKey\": \"{{claveGsg}}\"\n}",
              "options": {
