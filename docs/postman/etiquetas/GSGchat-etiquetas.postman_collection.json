            ],
            "url": "{{base}}/tienda/{{slug}}/admin/ia",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"activa\": true,\n  \"proveedor\": \"openai\",\n  \"servicio\": \"otro\",\n  \"baseUrl\": \"{{mock}}/ia/v1\",\n  \"modelo\": \"mock-etiquetas\",\n  \"token\": \"sk-mock-etiquetas-123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y la IA queda activa con clave', () => {",
