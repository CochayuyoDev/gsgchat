                  "} else {",
                  "  pm.collectionVariables.set('vueltas', 0);",
                  "  pm.test('el lote termino (no se quedo en curso)', () => pm.expect(e.enCurso).to.equal(false));",
                  "  pm.collectionVariables.set('reintento1', e.loteId);",
                  "",
                  "  pm.test('reintento: 2 enviadas, 1 fallida (Ana)', () => {",
                  "    pm.expect(e.tipo).to.equal('reintento');",
                  "    pm.expect(e.estado).to.equal('completado_con_errores');",
                  "    pm.expect(e.total).to.equal(3);",
                  "    pm.expect(e.syncEnviadas).to.equal(2);",
                  "    pm.expect(e.syncFallidas).to.equal(1);",
                  "  });",
                  "",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Mock: lo que recibió GSG (por número, sin tracking, idempotente, sin IA)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mock}}/control/estado",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const m = pm.response.json();",
                  "const tels = m.recibidas.map((r) => r.telefono).sort();",
                  "pm.test('llegaron Rosa y Luis', () => pm.expect(tels).to.eql(['51987650001', '51987650002']));",
                  "pm.test('cada envío va por número, sin tracking, con la API Key y Idempotency-Key = eventoId', () => {",
                  "  m.recibidas.forEach((r) => {",
                  "    pm.expect(r.cuerpo).to.not.have.property('tracking');",
                  "    pm.expect(r.cuerpo.telefono).to.match(/^51\\d{9}$/);",
                  "    pm.expect(r.cuerpo.telefonoNacional).to.equal(r.cuerpo.telefono.slice(2));",
                  "    pm.expect(r.conClave).to.equal(true);",
                  "    pm.expect(r.idempotencyKey).to.equal(r.cuerpo.eventoId);",
                  "  });",
                  "});",
                  "pm.test('las etiquetas son las de la IA', () => {",
                  "  const por = Object.fromEntries(m.recibidas.map((r) => [r.telefono, r.cuerpo.etiqueta]));",
                  "  pm.expect(por['51987650001']).to.equal('reagendar_entrega');",
                  "  pm.expect(por['51987650002']).to.equal('horario_fijo');",
                  "});",
                  "pm.test('Luis (dos contactos) llega UNA vez, con los 3 mensajes juntos', () => {",
                  "  const luis = m.recibidas.filter((r) => r.telefono === '51987650002');",
                  "  pm.expect(luis.length).to.equal(1);",
                  "  pm.expect(luis[0].cuerpo.mensajes).to.equal(3);",
                  "});",
                  "pm.test('el reintento no llamó a la IA', () => pm.expect(m.llamadasIA).to.equal(Number(pm.collectionVariables.get('iaTrasLote1'))));",
                  "const ana = m.rechazadas.filter((r) => r.telefono === '51987650003' && r.status === 503);",
                  "pm.test('Ana: GSG respondió 503', () => pm.expect(ana.length).to.equal(1));",
                  "pm.collectionVariables.set('eventoAna', ana[0] && ana[0].idempotencyKey);"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalle del reintento 1: estado de cada envío",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/tienda/{{slug}}/admin/chat/etiquetar/lotes/{{reintento1}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "const por = Object.fromEntries(j.conversaciones.map((c) => [c.phone, c]));",
                  "pm.test('el lote es un reintento terminado con errores', () => {",
                  "  pm.expect(j.lote.tipo).to.equal('reintento');",
                  "  pm.expect(j.lote.estado).to.equal('completado_con_errores');",
                  "  pm.expect(j.lote.terminoAt).to.be.a('string');",
                  "});",
                  "pm.test('Rosa y Luis: enviado', () => {",
                  "  pm.expect(por['51987650001'].sync.estado).to.equal('enviado');",
                  "  pm.expect(por['51987650002'].sync.estado).to.equal('enviado');",
                  "});",
                  "pm.test('Ana: fallido con el 503 y un solo intento (el del 401 no contó: no se llegó a intentar)', () => {",
                  "  pm.expect(por['51987650003'].sync.estado).to.equal('fallido');",
                  "  pm.expect(por['51987650003'].sync.intentos).to.equal(1);",
                  "  pm.expect(por['51987650003'].sync.error).to.match(/503/);",
                  "});",
                  "pm.test('el registro del lote apunta el 503 de Ana', () => {",
                  "  const ev = j.eventos.find((e) => e.codigo === 'gsg_no_disponible');",
                  "  pm.expect(ev.phone).to.equal('51987650003');",
                  "});"
                ]
              }
            }
          ]
        },
