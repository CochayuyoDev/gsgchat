{
  "info": {
    "_postman_id": "b45054b7-d994-587f-9dab-b164e91f1411",
    "name": "GSGchat - Etiquetas de chats y GSG",
    "description": "Prueba de punta a punta del etiquetado de Chats con IA y su envío a GSG por número de WhatsApp: lotes, estados, reintento solo de lo fallido (sin IA) y registro de eventos. Necesita el mock de IA y GSG (mock-externos.mjs) y los chats sembrados (sembrar.ts). Ver README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// La sesión va en cada llamada a GSGchat (no al mock), salvo en la que prueba entrar sin ella.",
          "const url = pm.request.url.toString();",
          "const cookie = pm.collectionVariables.get('cookie');",
          "if (cookie && url.startsWith(pm.environment.get('base')) && !pm.info.requestName.startsWith('Sin sesión')) {",
          "  pm.request.headers.upsert({ key: 'Cookie', value: cookie });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "cookie",
      "value": ""
    },
    {
      "key": "vueltas",
      "value": "0"
    }
  ],
  "item": [
    {
      "name": "0 · Preparación",
      "description": "Deja el mock vacío, entra con la cuenta de la tienda y conecta la IA (mock) y GSG (mock) con una clave que GSG va a rechazar.",
      "item": [
        {
          "name": "Mock: reiniciar IA y GSG",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{mock}}/control/reset",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sin sesión: el estado del etiquetado pide entrar",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/tienda/{{slug}}/admin/chat/etiquetar",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('no responde sin sesión (401)', () => pm.expect(pm.response.code).to.equal(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Entrar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/login",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{usuario}}\",\n  \"clave\": \"{{clave}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const cookies = pm.response.headers.all().filter((h) => h.key.toLowerCase() === 'set-cookie').map((h) => h.value.split(';')[0]);",
                  "pm.test('deja la cookie de sesión', () => pm.expect(cookies.length).to.be.above(0));",
                  "pm.collectionVariables.set('cookie', cookies.join('; '));"
                ]
              }
            }
          ]
        },
        {
          "name": "Configurar la IA (mock compatible con OpenAI)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
