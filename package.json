{
  "name": "wa-locator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WhatsApp + Google Maps: extraccion de coordenadas, ubicacion en vivo y envio masivo con guardas anti-bloqueo",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "migrate": "tsx src/db/migrate.ts",
    "extract": "tsx src/cli.ts",
    "templates:sync": "tsx src/templates/sync-cli.ts",
    "templates:lint": "tsx src/templates/push-cli.ts --lint",
    "templates:push": "tsx src/templates/push-cli.ts --push",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.1",
    "bullmq": "^5.34.5",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
