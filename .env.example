# Copiar a .env solo si quieres inyectar los secretos desde el entorno.
#
# No hace falta para arrancar: el sistema levanta sin credenciales y las pide
# por pantalla en /setup, que es la via recomendada. Lo que se guarde ahi tiene
# precedencia sobre estas variables.
#
# ADMIN_TOKEN y TRACKING_SECRET se generan solos en el primer arranque y quedan
# en .secrets.json; solo definelos aqui si prefieres fijarlos tu.

PORT=3000
# URL publica del servidor: es la que se manda dentro de los links de rastreo
# y la que Meta necesita para el webhook.
PUBLIC_BASE_URL=http://localhost:3000

DATABASE_URL=postgres://wa:wa@localhost:5432/wa_locator
REDIS_URL=redis://localhost:6379

# --- WhatsApp Cloud API (Meta) --- opcional: mejor pegarlas en /setup
GRAPH_API_VERSION=v21.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# App secret: valida la firma X-Hub-Signature-256 del webhook.
WHATSAPP_APP_SECRET=
# Cadena que eliges tu; Meta la repite en el GET de verificacion del webhook.
WHATSAPP_VERIFY_TOKEN=

# --- Google Maps --- opcional
# Vacia = las paginas de rastreo usan Leaflet + OpenStreetMap, sin clave.
# Si la pones, restringela por referrer HTTP: viaja al navegador.
GOOGLE_MAPS_API_KEY=

# --- Secretos propios --- opcional, se autogeneran
# ADMIN_TOKEN=
# TRACKING_SECRET=
TRACKING_TTL_MINUTES=120

# --- Guardas anti-bloqueo ---
# Envios iniciados por la empresa el primer dia de warm-up.
WARMUP_START_PER_DAY=50
# Factor de crecimiento diario durante el warm-up.
WARMUP_GROWTH=1.5
# Techo duro por 24 h, por debajo del tier que te de Meta.
DAILY_SEND_CAP=1000
# Maximo de mensajes de marketing que recibe un mismo contacto cada 7 dias.
MAX_MARKETING_PER_CONTACT_7D=2
# Palabras que cuentan como baja y como alta, separadas por coma.
OPT_OUT_KEYWORDS=baja,stop,cancelar,no more,unsubscribe
OPT_IN_KEYWORDS=alta,acepto,si quiero

# Caja geografica para descartar coordenadas absurdas: mexico | none
GEO_BBOX=mexico
