# Copiar a .env solo si quieres inyectar los secretos desde el entorno.
#
# No hace falta para arrancar: el sistema levanta sin credenciales y las pide
# por pantalla en /setup, que es la via recomendada. Lo que se guarde ahi tiene
# precedencia sobre estas variables.
#
# Casi todo lo de aqui es el punto de partida: nombre del negocio, horario de
# envio, ritmo, modo prueba y supervisor se cambian despues desde la pantalla
# (/panel#configuracion) sin reiniciar. Solo SOLO_NUMEROS es un freno que la
# pantalla puede apretar pero no soltar.
#
# TRACKING_SECRET se genera solo en el primer arranque y queda en
# .secrets.json; solo definelo aqui si prefieres fijarlo tu. No hay token de
# administracion: las personas entran por /login y los programas con una clave
# de API creada en /panel#integraciones.

PORT=3000
# URL publica del servidor: es la que se manda dentro de los links de rastreo
# y la que Meta necesita para el webhook.
PUBLIC_BASE_URL=http://localhost:3000
# Sin Postgres: DATABASE_URL=pglite://./.wa-data abre la base embebida (aplica
# las migraciones sola). Con Postgres, la URL normal postgres://...

DATABASE_URL=postgres://wa:wa@localhost:5432/wa_locator
REDIS_URL=redis://localhost:6379

# --- WhatsApp Cloud API (Meta) --- opcional: mejor pegarlas en /setup
GRAPH_API_VERSION=v21.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# App secret: valida la firma X-Hub-Signature-256 del webhook.
WHATSAPP_APP_SECRET=
# Cadena que eliges tu; Meta la repite en el GET de verificacion del webhook.
WHATSAPP_VERIFY_TOKEN=

# --- Google Maps --- opcional
# Vacia = las paginas de rastreo usan Leaflet + OpenStreetMap, sin clave.
# Si la pones, restringela por referrer HTTP: viaja al navegador.
GOOGLE_MAPS_API_KEY=

# --- Secretos propios --- opcional, se autogeneran
# TRACKING_SECRET=
TRACKING_TTL_MINUTES=120

# --- Guardas anti-bloqueo ---
# Warm-up del numero. Sin valor manda el perfil de ritmo (ver mas abajo):
# la API oficial arranca en 50/dia y el cliente no oficial en 20/dia.
#WARMUP_START_PER_DAY=50
# Factor de crecimiento diario durante el warm-up (1.5 oficial, 1.6 no oficial).
#WARMUP_GROWTH=1.5
# Techo duro por 24 h, por debajo del tier que te de Meta (1000 / 400).
#DAILY_SEND_CAP=1000
# Dias sin enviar nada tras los que el warm-up vuelve a empezar (7 / 4).
#WARMUP_REINICIO_DIAS=7
# Maximo de mensajes de marketing que recibe un mismo contacto cada 7 dias.
MAX_MARKETING_PER_CONTACT_7D=2

# --- Ritmo y salud del numero (ver README: "Que evita realmente que bloqueen el numero") ---
# Todo tiene un valor por defecto segun el perfil: `cloud` (API oficial de
# Meta) o `no_oficial` (Baileys / WAHA, bastante mas lento). El perfil sale
# del proveedor; `auto` es lo normal.
RITMO_PERFIL=auto
# Envios iniciados por la empresa por minuto y por hora (20/400 oficial, 4/80 no oficial).
#RITMO_MAX_POR_MINUTO=20
#RITMO_MAX_POR_HORA=400
# Pausa entre dos envios iniciados por la empresa, en segundos; se sortea
# entre los dos (2-6 oficial, 15-45 no oficial).
#RITMO_PAUSA_MIN_SEG=2
#RITMO_PAUSA_MAX_SEG=6
# Contactos a los que se escribe por primera vez, por dia. 0 = sin limite
# (oficial); 80 en no oficial: escribir a mucha gente que no te tiene
# agendada es la senal mas fuerte de spam en un cliente web.
#RITMO_NUEVOS_CONTACTOS_DIA=0
# Mensajes de negocio al mismo contacto por dia, y minutos entre dos.
#RITMO_MAX_POR_CONTACTO_DIA=3
#RITMO_SEPARACION_CONTACTO_MIN=10
# Fraccion del tier de Meta (destinatarios unicos por 24 h) que se usa como
# techo propio: al 90 % se para, para no rozar el RESTRICTED.
#RITMO_FRACCION_TIER=0.9
# Horario en el que sale lo iniciado por la empresa (campanas, secuencias,
# rutas), hora del negocio (TIMEZONE). Responder a un cliente no tiene horario.
#HORARIO_ENVIO_INICIO=9
#HORARIO_ENVIO_FIN=20
# Dias permitidos, 0 = domingo. Por defecto lunes a sabado.
#HORARIO_ENVIO_DIAS=1,2,3,4,5,6
# Simular escritura (composing / paused) antes de cada envio con el cliente
# no oficial. Encendido en ese perfil; en la API oficial no aplica.
#HUMANIZAR=true
# El monitor pausa el numero solo cuando el riesgo llega a rojo, cuanto
# descansa (minutos) y cuanto dura la rampa de vuelta (10 % -> 100 %).
#SALUD_AUTO_PAUSA=true
#SALUD_PAUSA_ROJA_MIN=240
#SALUD_RAMPA_MIN=120
# Umbrales del riesgo, en porcentaje.
#SALUD_MAX_FALLOS_PCT=20          # fallos sobre los ultimos 50 envios
#SALUD_MAX_SIN_WHATSAPP_PCT=15    # numeros sin WhatsApp: lista sucia
#SALUD_MAX_BAJAS_PCT=2            # bajas sobre envios en 24 h
#SALUD_MIN_ENTREGA_PCT=60         # entregados sobre lo enviado hace mas de 1 h
#SALUD_MAX_QUEJAS_PCT=5           # "no soy yo" / "no me escriban"
#SALUD_MIN_ENVIOS_JUZGAR=20       # con menos envios los porcentajes no cuentan
# Envios seguidos sin respuesta a partir de los cuales el contacto descansa de
# marketing (3 oficial, 2 no oficial), y cuantos dias.
#SALUD_FATIGA_ENVIOS=3
#SALUD_FATIGA_DESCANSO_DIAS=14
# Plantilla recien aprobada: cuantos envios por dia durante sus primeros dias.
#PLANTILLA_NUEVA_DIAS=3
#PLANTILLA_NUEVA_POR_DIA=100
# A quien avisar por WhatsApp cuando el numero cambia de nivel. Vacio = RUTAS_SUPERVISOR.
#SALUD_AVISAR_A=

# MODO PRUEBA: solo se escribe a estos numeros (separados por coma). Con la
# lista puesta, CUALQUIER envio a otro numero -campana, secuencia, rutas, chat
# a mano, respuesta del asistente- se bloquea y queda anotado. Es la red para
# probar contra un WhatsApp de verdad sin escribirle a un cliente por error.
# Vacio = produccion, a todos.
#SOLO_NUMEROS=51902464984,51912426667
# Palabras que cuentan como baja y como alta, separadas por coma.
OPT_OUT_KEYWORDS=baja,stop,cancelar,no more,unsubscribe
OPT_IN_KEYWORDS=alta,acepto,si quiero

# Caja geografica para descartar coordenadas absurdas: lima | mexico | none
GEO_BBOX=lima

# --- Proveedor ---------------------------------------------------------
# cloud = API oficial de Meta (recomendado).
# waha  = contenedor de WAHA, se conecta con codigo QR y funciona con
#         cualquier WhatsApp, incluido el verde de consumidor. Emula
#         WhatsApp Web: esta fuera de los terminos de Meta y el numero
#         puede acabar baneado sin aviso. Usa un numero secundario.
WHATSAPP_PROVIDER=cloud
WAHA_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION=default
# WEBJS | NOWEB | GOWS | WPP. Vacio = el que traiga el contenedor.
WAHA_ENGINE=

# --- Respaldo de conversaciones ---------------------------------------
# Donde se guardan los hilos cerrados (.ndjson.gz). Fuera de la base a
# proposito: cerrar un chat existe para que la base deje de crecer.
ARCHIVE_DIR=respaldos
# Dias sin mensajes tras los que una conversacion se cierra sola. 0 = nunca.
ARCHIVE_INACTIVE_DAYS=60
# Respaldar y limpiar en cuanto la ficha pasa a enviada o descartada.
ARCHIVE_ON_LEAD_CLOSE=true

# --- Ubicaciones para reparto (GSG) -----------------------------------
# Pausa entre un mensaje y el siguiente: se sortea entre los dos valores.
# Es lo unico que de verdad evita que bloqueen el numero en un envio largo.
RUTAS_PAUSA_MIN_SEG=15
RUTAS_PAUSA_MAX_SEG=30
# Minutos que se espera una respuesta antes de volver a escribir.
RUTAS_ESPERA_MIN=30
# Mensajes por cliente antes de pasarlo al repartidor.
RUTAS_MAX_INTENTOS=3
# Franja horaria de envio, en la hora del negocio (TIMEZONE).
RUTAS_HORA_INICIO=9
RUTAS_HORA_FIN=19
# Plan de numeracion con el que se revisan los telefonos: peru | mexico | generico
RUTAS_PAIS=peru

# A quien se le avisa por WhatsApp cuando hay casos parados esperando a una
# persona (numeros mal escritos, clientes que contestaron otra cosa...).
# Vacio = no se avisa a nadie y todo queda en la pantalla.
RUTAS_SUPERVISOR=
# Casos parados a partir de los cuales se avisa, y cada cuanto como maximo.
RUTAS_ALERTA_MIN_CASOS=1
RUTAS_ALERTA_CADA_MIN=60
# Cada cuanto se le manda a GSG el avance del lote en marcha.
RUTAS_RESUMEN_CADA_MIN=30

# La API del sistema de GSG. Vacia = todavia no esta conectada y lo
# reportable se acumula en la cola; al rellenarla sale todo lo pendiente.
GSG_URL=
GSG_TOKEN=
# Los dos se pueden dejar vacios y conectar GSG desde la pantalla Conexion
# (API real o simulador). El contrato para sus programadores se descarga
# desde ahi (docs/CONTRATO-GSG.md).

# Solo en el SaaS (lo escribe saas/alta.ts): donde pregunta esta tienda por
# su plan y su token. Vacios = instalacion suelta, sin plan ni limites.
PLAN_URL=
PLAN_TOKEN=
