# Configuracion del SaaS (copiar a saas/.env).

# El dominio del que cuelga cada tienda: tienda1.wa.tuservicio.com. Hace
# falta un DNS comodin (*.wa.tuservicio.com -> la IP del servidor); Caddy
# saca el HTTPS solo. Para probar en una maquina: localhost (o
# localhost:8080 si el 80 esta ocupado); *.localhost resuelve solo.
DOMINIO_BASE=wa.tuservicio.com

# MariaDB comun (una base por tienda): la clave de root y del usuario wa.
# Cambiar en produccion.
MARIADB_PASSWORD=cambiar-esta-clave

# Valores por defecto de las tiendas nuevas.
PAIS=peru
TIMEZONE=America/Lima
GEO_BBOX=none

# El panel maestro (npm run saas:maestro): usuario y contrasena. Sin
# MAESTRO_CLAVE, el panel no arranca.
MAESTRO_USUARIO=maestro
MAESTRO_CLAVE=
MAESTRO_PUERTO=3900

# Solo si DOMINIO_BASE lleva puerto (localhost:8080): el mismo numero.
PUERTO_HTTP=80
